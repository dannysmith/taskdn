filters:
  and:
    - file.inFolder("areas")
    - file.name != "Overview"
properties:
  file.name:
    displayName: Area
  note.status:
    displayName: Status
  note.type:
    displayName: Type
  note.description:
    displayName: Description
views:
  - type: table
    name: All Areas
    order:
      - file.name
      - status
      - type
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Active
    filters:
      not:
        - note.status == "archived"
    order:
      - file.name
      - type
    sort:
      - property: file.name
        direction: ASC
