---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import splashImage from '../assets/icon-1024-trans.png'
import desktopScreenshot from '../assets/desktop-app-screenshot.png'
import Button from '../components/Button.astro'
import DesktopAppDownloadButtons from '../components/DesktopAppDownloadButtons.astro'
import CLIDemo from '../components/demos/CLIDemo.astro'
import ObsidianDemo from '../components/demos/ObsidianDemo.astro'
import ClaudeDemo from '../components/demos/ClaudeDemo.astro'
---

<Layout
  title="Taskdn — Plaintext Task Management"
  description="Beautiful task management with your data stored as markdown files you actually own."
>
  <main>
    <div class="hero">
      <Image src={splashImage} alt="Taskdn" class="splash-image" />

      <h1>Taskdn</h1>
      <p class="tagline">
        Beautiful task management with your data stored as markdown files you
        actually own.
      </p>

      <div class="actions">
        <a href="/getting-started" class="button primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
            ></path></svg
          >
          Read the Docs
        </a>
        <a
          href="https://github.com/dannysmith/taskdn"
          class="button secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path></svg
          >
          View on GitHub
        </a>
      </div>
    </div>

    <section class="concept">
      <div class="concept-grid">
        <div class="file-example">
          <div class="file-header">
            <span class="file-icon">📄</span>
            <span class="file-name">tasks/review-quarterly-report.md</span>
          </div>
          <pre><code><span class="yaml-delimiter">---</span>
<span class="yaml-key">title:</span> <span class="yaml-string">Review quarterly report</span>
<span class="yaml-key">status:</span> <span class="yaml-value">in-progress</span>
<span class="yaml-key">due:</span> <span class="yaml-date">2025-03-15</span>
<span class="yaml-key">projects:</span>
  <span class="yaml-link">- '[[Q1 Planning]]'</span>
<span class="yaml-delimiter">---</span>

<span class="md-heading">## Notes</span>
Key points to review:
- Revenue projections
- Budget allocations</code></pre>
        </div>

        <div class="hierarchy-items">
          <div class="hierarchy-item hierarchy-areas">
            <span class="hierarchy-icon">🗂️</span>
            <div class="hierarchy-text">
              <span class="hierarchy-label">Areas</span>
              <span class="hierarchy-desc">Ongoing responsibilities</span>
            </div>
          </div>
          <div class="hierarchy-arrow">↓</div>
          <div class="hierarchy-item hierarchy-projects">
            <span class="hierarchy-icon">📁</span>
            <div class="hierarchy-text">
              <span class="hierarchy-label">Projects</span>
              <span class="hierarchy-desc">Goals with an end</span>
            </div>
          </div>
          <div class="hierarchy-arrow">↓</div>
          <div class="hierarchy-item hierarchy-tasks">
            <span class="hierarchy-icon">✓</span>
            <div class="hierarchy-text">
              <span class="hierarchy-label">Tasks</span>
              <span class="hierarchy-desc">Things you do</span>
            </div>
          </div>
        </div>
      </div>

      <p class="concept-text">
        Your tasks are just markdown files. Edit them anywhere, version them
        with git, back them up however you like.
      </p>
    </section>

    <!-- Desktop App -->
    <section class="product">
      <div class="product-content">
        <div class="product-header">
          <span class="product-icon">🖥️</span>
          <h2>Desktop App</h2>
        </div>

        <p class="product-description">
          A task app that actually feels good to use—fast, keyboard-driven,
          thoughtfully designed—but your files stay on disk as markdown. No
          lock-in. No wondering what happens when the company gets acquired.
        </p>

        <ul class="product-features">
          <li>Global shortcut captures tasks without breaking your flow</li>
          <li>
            Today, Inbox, This Week views work out of the box—no configuration
          </li>
          <li>Keyboard-first for people who find clicking slow</li>
          <li>Lists, Kanban, or calendar—whatever fits how you're thinking</li>
        </ul>

        <div class="product-actions">
          <DesktopAppDownloadButtons />
          <Button href="/desktop/overview" variant="primary" showArrow>
            Learn More
          </Button>
        </div>
      </div>

      <div class="product-visual">
        <Image
          src={desktopScreenshot}
          alt="Taskdn desktop app showing project view with task list and detail sidebar"
        />
      </div>
    </section>

    <!-- CLI -->
    <section class="product reverse">
      <div class="product-content">
        <div class="product-header">
          <span class="product-icon">⌨️</span>
          <h2>Command Line Interface</h2>
        </div>

        <p class="product-description">
          Two modes for two audiences. For you: pretty output, fuzzy search,
          natural language dates. For AI agents: structured markdown designed
          for context windows—token-efficient, still useful if truncated.
        </p>

        <ul class="product-features">
          <li>See what's overdue, due today, and in progress—one command</li>
          <li>
            Give AI full context in a single call: project, tasks, timeline,
            relationships
          </li>
          <li>Search the way you'd say it, not how files are named</li>
          <li>"Next Friday" instead of ISO dates</li>
        </ul>

        <Button href="/cli/overview" variant="primary" showArrow>
          Learn More
        </Button>
      </div>

      <div class="product-visual demo-frame">
        <CLIDemo />
      </div>
    </section>

    <!-- Obsidian Plugin -->
    <section class="product">
      <div class="product-content">
        <div class="product-header">
          <span class="product-icon">💎</span>
          <h2>Obsidian Plugin</h2>
        </div>

        <p class="product-description">
          You're in Obsidian to write, not manage tasks. Link to a task and see
          its status, project, and due date right there. Check it off without
          opening another file.
        </p>

        <ul class="product-features">
          <li>Task links become widgets showing what you need to know</li>
          <li>One click to mark done—no context switch</li>
          <li>Colors tell you what's blocked or overdue at a glance</li>
          <li>Turn any checklist item into a proper task when it grows up</li>
        </ul>

        <Button href="/obsidian/plugin" variant="primary" showArrow>
          Learn More
        </Button>
      </div>

      <div class="product-visual demo-frame">
        <ObsidianDemo />
      </div>
    </section>

    <!-- Claude Code Plugin -->
    <section class="product reverse">
      <div class="product-content">
        <div class="product-header">
          <span class="product-icon">🤖</span>
          <h2>Claude Code Plugin</h2>
        </div>

        <p class="product-description">
          Claude can already read your markdown files. This teaches it how your
          system works—so "What's overdue?" gets a real answer, not a
          frontmatter tutorial.
        </p>

        <ul class="product-features">
          <li>Ask naturally: "What should I focus on today?"</li>
          <li>Create tasks mid-conversation without opening another app</li>
          <li>Help with the tedious parts—inbox processing, weekly reviews</li>
          <li>Works from any project directory, not just your vault</li>
        </ul>

        <Button href="/claude-code/overview" variant="primary" showArrow>
          Learn More
        </Button>
      </div>

      <div class="product-visual demo-frame">
        <ClaudeDemo />
      </div>
    </section>
  </main>

  <footer>
    <a href="/privacy">Privacy Policy</a>
    <span class="separator">·</span>
    <span>
      Made with ❤️ by <a
        href="https://danny.is"
        target="_blank"
        rel="noopener noreferrer">Danny Smith</a
      >
    </span>
  </footer>
</Layout>

<style>
  main {
    flex: 1;
    display: block;
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Hero section */
  .hero,
  .concept {
    max-width: 800px;
    margin-inline: auto;
  }

  .hero {
    text-align: center;
    padding-top: 2rem;
    margin-bottom: 4rem;
  }

  .splash-image {
    width: 70%;
    max-width: 300px;
    height: auto;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .tagline {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    margin-inline: auto;
    line-height: 1.5;
    max-width: 500px;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 1rem;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;

    svg {
      flex-shrink: 0;
    }

    &:hover {
      text-decoration: none;
    }

    &.primary {
      background: var(--color-accent);
      color: white;

      &:hover {
        background: var(--color-accent-hover);
      }
    }

    &.secondary {
      background: var(--color-bg-2);
      color: var(--color-text);
      border: 1px solid var(--color-border);

      &:hover {
        border-color: var(--color-text-muted);
        background: var(--color-bg);
      }
    }
  }

  /* Concept section */
  .concept {
    margin-bottom: 4rem;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }

  .file-example {
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    text-align: left;

    pre {
      margin: 0;
      padding: 1rem;
      overflow-x: auto;
      font-size: 0.8125rem;
      line-height: 1.6;
    }

    code {
      font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    }
  }

  .file-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }

  .file-icon {
    font-size: 0.875rem;
  }

  .file-name {
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
  }

  /* YAML syntax highlighting - use light-dark() for theme adaptation */
  .yaml-delimiter {
    color: var(--color-text-muted);
  }

  .yaml-key {
    color: var(--color-accent);
  }

  .yaml-string {
    color: var(--color-text);
  }

  .yaml-value {
    color: light-dark(#ad5c00, #d0a215);
  }

  .yaml-date {
    color: light-dark(#66800b, #879a39);
  }

  .yaml-link {
    color: var(--color-accent);
    opacity: 0.8;
  }

  .md-heading {
    color: var(--color-text);
    font-weight: 600;
  }

  .concept-text {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  .hierarchy-items {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hierarchy-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    width: 190px;

    &.hierarchy-areas {
      background: rgba(67, 133, 190, 0.1);
      border: 1px solid rgba(67, 133, 190, 0.2);
    }

    &.hierarchy-projects {
      background: rgba(135, 154, 57, 0.1);
      border: 1px solid rgba(135, 154, 57, 0.2);
    }

    &.hierarchy-tasks {
      background: rgba(208, 162, 21, 0.1);
      border: 1px solid rgba(208, 162, 21, 0.2);
    }
  }

  .hierarchy-icon {
    font-size: 1.25rem;
    width: 1.75rem;
    text-align: center;
    flex-shrink: 0;
  }

  .hierarchy-text {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
  }

  .hierarchy-label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .hierarchy-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .hierarchy-arrow {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    opacity: 0.5;
    line-height: 1;
  }

  /* Concept section responsive */
  @media (max-width: 600px) {
    .concept-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hierarchy-items {
      flex-direction: row;
      justify-content: center;
      gap: 0.5rem;
    }

    .hierarchy-item {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
      padding: 0.625rem 0.5rem;
      width: auto;
      flex: 1;
      max-width: 120px;
    }

    .hierarchy-text {
      align-items: center;
    }

    .hierarchy-arrow {
      transform: rotate(-90deg);
    }
  }

  /* Product sections */
  .product {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 5rem 0;
    max-width: 1100px;
    margin: 0 auto;

    &.reverse {
      direction: rtl;

      > * {
        direction: ltr;
      }
    }
  }

  .product-content {
    max-width: 480px;
  }

  .product-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;

    h2 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text);
      margin: 0;
    }
  }

  .product-icon {
    font-size: 1.75rem;
  }

  .product-description {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .product-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;

    li {
      font-size: 0.9375rem;
      color: var(--color-text);
      padding-left: 1.5rem;
      position: relative;
      line-height: 1.5;

      &::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.5em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-accent);
        opacity: 0.7;
      }
    }
  }

  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product-visual {
    border-radius: 0.5rem;
    overflow: hidden;

    > :global(img) {
      width: 100%;
      height: auto;
    }
  }

  /* Demo frame styling for animated demos */
  .demo-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;

    > :global(*) {
      position: absolute;
      inset: 0;
    }
  }

  /* Product sections responsive */
  @media (max-width: 900px) {
    .product {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 1.5rem;

      &.reverse {
        direction: ltr;
      }
    }

    .product-content {
      max-width: none;
      text-align: center;
    }

    .product-header {
      justify-content: center;
    }

    .product-features {
      text-align: left;
      max-width: 400px;
      margin-inline: auto;
    }

    .product-actions {
      max-width: 400px;
      margin: 0 auto;
    }

    .product-visual {
      max-width: 500px;
      margin: 0 auto;
      width: 100%;
    }
  }

  /* Footer */
  footer {
    padding: 1.5rem 2rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);

    a {
      color: var(--color-text-muted);

      &:hover {
        color: var(--color-text);
      }
    }
  }

  .separator {
    margin-inline: 0.5rem;
  }
</style>
