---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import splashImage from '../assets/icon-1024-trans.png'
---

<Layout
  title="Taskdn — Plaintext Task Management"
  description="Beautiful task management with your data stored as markdown files you actually own."
>
  <main>
    <div class="hero">
      <Image src={splashImage} alt="Taskdn" class="splash-image" />

      <h1>Taskdn</h1>
      <p class="tagline">
        Beautiful task management with your data stored as markdown files you
        actually own.
      </p>

      <div class="actions">
        <a href="/getting-started" class="button primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
            ></path></svg
          >
          Read the Docs
        </a>
        <a
          href="https://github.com/dannysmith/taskdn"
          class="button secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path></svg
          >
          View on GitHub
        </a>
      </div>
    </div>

    <section class="concept">
      <div class="file-example">
        <div class="file-header">
          <span class="file-icon">📄</span>
          <span class="file-name">tasks/review-quarterly-report.md</span>
        </div>
        <pre><code><span class="yaml-delimiter">---</span>
<span class="yaml-key">title:</span> <span class="yaml-string">Review quarterly report</span>
<span class="yaml-key">status:</span> <span class="yaml-value">in-progress</span>
<span class="yaml-key">due:</span> <span class="yaml-date">2025-01-15</span>
<span class="yaml-key">projects:</span>
  <span class="yaml-link">- '[[Q1 Planning]]'</span>
<span class="yaml-delimiter">---</span>

<span class="md-heading">## Notes</span>
Key points to review:
- Revenue projections
- Budget allocations</code></pre>
      </div>

      <p class="concept-text">
        Your tasks are just markdown files. Edit them anywhere, version them
        with git, back them up however you like.
      </p>
    </section>

    <section class="hierarchy">
      <div class="hierarchy-items">
        <div class="hierarchy-item">
          <span class="hierarchy-icon">🗂️</span>
          <span class="hierarchy-label">Areas</span>
          <span class="hierarchy-desc">Ongoing responsibilities</span>
        </div>
        <span class="hierarchy-arrow">→</span>
        <div class="hierarchy-item">
          <span class="hierarchy-icon">📁</span>
          <span class="hierarchy-label">Projects</span>
          <span class="hierarchy-desc">Goals with an end</span>
        </div>
        <span class="hierarchy-arrow">→</span>
        <div class="hierarchy-item">
          <span class="hierarchy-icon">✓</span>
          <span class="hierarchy-label">Tasks</span>
          <span class="hierarchy-desc">Things you do</span>
        </div>
      </div>
    </section>

    <section class="products">
      <h2>The Suite</h2>
      <div class="product-grid">
        <a href="/desktop/overview" class="product">
          <span class="product-icon">🖥️</span>
          <span class="product-name">Desktop App</span>
          <span class="product-desc">Beautiful day-to-day task management</span>
          <span class="product-status coming-soon">Coming Soon</span>
        </a>
        <a href="/cli/overview" class="product">
          <span class="product-icon">⌨️</span>
          <span class="product-name">CLI</span>
          <span class="product-desc">Terminal interface for humans & AI</span>
          <span class="product-status available">Available</span>
        </a>
        <a href="/obsidian/plugin" class="product">
          <span class="product-icon">💎</span>
          <span class="product-name">Obsidian Plugin</span>
          <span class="product-desc">Tasks inside your vault</span>
          <span class="product-status available">Available</span>
        </a>
        <a href="/claude-code/overview" class="product">
          <span class="product-icon">🤖</span>
          <span class="product-name">Claude Code</span>
          <span class="product-desc">AI-assisted task management</span>
          <span class="product-status available">Available</span>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <a href="/privacy">Privacy Policy</a>
    <span class="separator">·</span>
    <span>
      Made with ❤️ by <a
        href="https://danny.is"
        target="_blank"
        rel="noopener noreferrer">Danny Smith</a
      >
    </span>
  </footer>
</Layout>

<style>
  main {
    flex: 1;
    display: block;
    padding: 2rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .hero {
    text-align: center;
    padding-top: 2rem;
    margin-bottom: 4rem;
  }

  .splash-image {
    width: 70%;
    max-width: 300px;
    height: auto;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .tagline {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    line-height: 1.5;
    max-width: 500px;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 1rem;
    transition: all 0.15s ease;
  }

  .button svg {
    flex-shrink: 0;
  }

  .button:hover {
    text-decoration: none;
  }

  .button.primary {
    background: var(--color-accent);
    color: white;
  }

  .button.primary:hover {
    background: var(--color-accent-hover);
  }

  .button.secondary {
    background: var(--color-bg-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .button.secondary:hover {
    border-color: var(--color-text-muted);
    background: var(--color-bg);
  }

  /* File example section */
  .concept {
    text-align: center;
    margin-bottom: 4rem;
  }

  .file-example {
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    text-align: left;
  }

  .file-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }

  .file-icon {
    font-size: 0.875rem;
  }

  .file-name {
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
  }

  .file-example pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .file-example code {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
  }

  .yaml-delimiter {
    color: var(--color-text-muted);
  }
  .yaml-key {
    color: var(--color-accent);
  }
  .yaml-string {
    color: var(--color-text);
  }
  .yaml-value {
    color: #d0a215;
  }
  .yaml-date {
    color: #879a39;
  }
  .yaml-link {
    color: var(--color-accent);
    opacity: 0.8;
  }
  .md-heading {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (prefers-color-scheme: light) {
    .yaml-value {
      color: #ad5c00;
    }
    .yaml-date {
      color: #66800b;
    }
  }

  .concept-text {
    margin-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  /* Hierarchy section */
  .hierarchy {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hierarchy-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hierarchy-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .hierarchy-icon {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .hierarchy-label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .hierarchy-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .hierarchy-arrow {
    color: var(--color-text-muted);
    font-size: 1.25rem;
    opacity: 0.5;
  }

  /* Products section */
  .products {
    text-align: center;
    margin-bottom: 2rem;
  }

  .products h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }

  .product {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-align: left;
    transition: all 0.15s ease;
  }

  .product:hover {
    text-decoration: none;
    border-color: var(--color-text-muted);
  }

  .product-icon {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .product-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .product-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .product-status {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }

  .product-status.available {
    background: rgba(135, 154, 57, 0.15);
    color: #879a39;
  }

  .product-status.coming-soon {
    background: rgba(208, 162, 21, 0.15);
    color: #d0a215;
  }

  @media (prefers-color-scheme: light) {
    .product-status.available {
      background: rgba(102, 128, 11, 0.1);
      color: #66800b;
    }

    .product-status.coming-soon {
      background: rgba(173, 92, 0, 0.1);
      color: #ad5c00;
    }
  }

  footer {
    padding: 1.5rem 2rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  footer a {
    color: var(--color-text-muted);
  }

  footer a:hover {
    color: var(--color-text);
  }

  .separator {
    margin: 0 0.5rem;
  }
</style>
