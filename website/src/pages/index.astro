---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import splashImage from '../assets/icon-1024-trans.png';
---

<Layout
  title="Taskdn — Plaintext Task Management"
  description="Task management that feels as slick as Things, with your data stored as markdown files you actually own."
>
  <main>
    <div class="hero">
      <Image src={splashImage} alt="Taskdn" class="splash-image" />

      <h1>Taskdn</h1>
      <p class="tagline">
        Task management that feels as slick as Things, with your data stored as
        markdown files you actually own.
      </p>

      <div class="actions">
        <a href="/getting-started" class="button primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          Read the Docs
        </a>
        <a
          href="https://github.com/dannysmith/taskdn"
          class="button secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          View on GitHub
        </a>
      </div>
    </div>
  </main>

  <footer>
    <a href="/privacy">Privacy Policy</a>
    <span class="separator">·</span>
    <span>
      Made with ❤️ by <a href="https://danny.is" target="_blank" rel="noopener noreferrer">Danny Smith</a>
    </span>
  </footer>
</Layout>

<style>
  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .hero {
    text-align: center;
  }

  .splash-image {
    width: 70%;
    max-width: 400px;
    height: auto;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 1rem;
    transition: all 0.15s ease;
  }

  .button svg {
    flex-shrink: 0;
  }

  .button:hover {
    text-decoration: none;
  }

  .button.primary {
    background: var(--color-accent);
    color: white;
  }

  .button.primary:hover {
    background: var(--color-accent-hover);
  }

  .button.secondary {
    background: var(--color-bg-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .button.secondary:hover {
    border-color: var(--color-text-muted);
    background: var(--color-bg);
  }

  footer {
    padding: 1.5rem 2rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  footer a {
    color: var(--color-text-muted);
  }

  footer a:hover {
    color: var(--color-text);
  }

  .separator {
    margin: 0 0.5rem;
  }
</style>
