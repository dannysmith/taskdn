---
// Download buttons for macOS and Windows desktop app
// Uses container queries to stack buttons when space is limited
---

<div class="download-buttons">
  <a href="/taskdn-desktop-latest.dmg" class="download-btn" data-os="macos">
    <svg
      viewBox="0 0 24 24"
      fill="currentColor"
      class="os-icon"
      aria-hidden="true"
    >
      <path
        d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
      ></path>
    </svg>
    <span class="btn-text">
      <span class="btn-label">Download for macOS</span>
      <span class="btn-note">Alpha Release</span>
    </span>
  </a>

  <a href="/taskdn-desktop-latest.msi" class="download-btn" data-os="windows">
    <svg
      viewBox="0 0 24 24"
      fill="currentColor"
      class="os-icon"
      aria-hidden="true"
    >
      <path
        d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .15V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 .25V22l-10-1.91V13.1l10 .15z"
      ></path>
    </svg>
    <span class="btn-text">
      <span class="btn-label">Download for Windows</span>
      <span class="btn-note">Experimental</span>
    </span>
  </a>
</div>

<script>
  function detectOS(): 'macos' | 'windows' | null {
    const userAgent = navigator.userAgent.toLowerCase()
    const platform = navigator.platform?.toLowerCase() || ''
    if (platform.includes('mac') || userAgent.includes('mac')) return 'macos'
    if (platform.includes('win') || userAgent.includes('win')) return 'windows'
    return null
  }

  function highlightOSButton() {
    const os = detectOS()
    if (!os) return
    document.querySelectorAll('.download-btn').forEach((btn) => {
      if ((btn as HTMLElement).dataset.os === os) {
        btn.classList.add('recommended')
      }
    })
  }

  highlightOSButton()
  document.addEventListener('astro:page-load', highlightOSButton)
</script>

<style>
  /*
   * CSS variables with fallbacks for both Starlight (--sl-color-*) and
   * standalone pages (--color-*), with hardcoded defaults as final fallback.
   */
  .download-buttons {
    --_text: var(--sl-color-text, var(--color-text, #1c1b1a));
    --_text-muted: var(--sl-color-gray-3, var(--color-text-muted, #878580));
    --_bg: var(--sl-color-bg, var(--color-bg, #fffcf0));
    --_bg-2: var(--sl-color-gray-6, var(--color-bg-2, #f2f0e5));
    --_border: var(--sl-color-gray-5, var(--color-border, #e6e4d9));
    --_accent: var(--sl-color-accent, var(--color-accent, #4385be));
    --_accent-hover: var(--sl-color-accent-high, var(--color-accent-hover, #205ea6));

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    width: 100%;
    container-type: inline-size;

    /* Stack when container is narrow */
    @container (max-width: 380px) {
      grid-template-columns: 1fr;
    }
  }

  .download-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 0.875rem;
    background: var(--_bg-2);
    color: var(--_text);
    border: 1px solid var(--_border);
    transition: background-color 0.15s ease, border-color 0.15s ease;
    text-decoration: none;

    &:hover {
      background: var(--_bg);
      border-color: var(--_text-muted);
      text-decoration: none;
    }

    &.recommended {
      background: var(--_accent);
      color: white;
      border-color: var(--_accent);

      &:hover {
        background: var(--_accent-hover);
        border-color: var(--_accent-hover);
      }

      .btn-note {
        color: rgba(255, 255, 255, 0.8);
      }
    }
  }

  .os-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .btn-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    line-height: 1.2;
  }

  .btn-label {
    white-space: nowrap;
  }

  .btn-note {
    font-size: 0.6875rem;
    color: var(--_text-muted);
    font-weight: 400;
  }
</style>
