---
interface Props {
  /**
   * Show the "Learn More" link alongside download buttons
   */
  showLearnMore?: boolean
  /**
   * Compact mode for use in docs pages
   */
  compact?: boolean
}

const { showLearnMore = false, compact = false } = Astro.props
---

<div class:list={['download-buttons', { compact }]}>
  <div class="os-buttons">
    <a
      href="/taskdn-desktop-latest.dmg"
      class="download-btn macos"
      data-os="macos"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="os-icon">
        <path
          d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
        ></path>
      </svg>
      <span class="btn-text">
        <span class="btn-label">Download for macOS</span>
        <span class="btn-note">Alpha Release</span>
      </span>
    </a>

    <a
      href="/taskdn-desktop-latest.msi"
      class="download-btn windows"
      data-os="windows"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="os-icon">
        <path
          d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .15V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 .25V22l-10-1.91V13.1l10 .15z"
        ></path>
      </svg>
      <span class="btn-text">
        <span class="btn-label">Download for Windows</span>
        <span class="btn-note">Experimental Alpha Release</span>
      </span>
    </a>
  </div>

  {
    showLearnMore && (
      <a href="/desktop/overview" class="learn-more">
        Learn More
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    )
  }
</div>

<script>
  // Detect OS and highlight the appropriate button
  function detectOS(): 'macos' | 'windows' | null {
    const userAgent = navigator.userAgent.toLowerCase()
    const platform = navigator.platform?.toLowerCase() || ''

    if (platform.includes('mac') || userAgent.includes('mac')) {
      return 'macos'
    }
    if (platform.includes('win') || userAgent.includes('win')) {
      return 'windows'
    }
    return null
  }

  function highlightOSButton() {
    const os = detectOS()
    if (!os) return

    document.querySelectorAll('.download-btn').forEach((btn) => {
      const btnOS = (btn as HTMLElement).dataset.os
      if (btnOS === os) {
        btn.classList.add('recommended')
      }
    })
  }

  // Run on page load
  highlightOSButton()

  // Also run on Astro page transitions
  document.addEventListener('astro:page-load', highlightOSButton)
</script>

<style>
  .download-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .os-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    width: 100%;
  }

  .download-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 0.875rem;
    background: var(--color-bg-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .download-btn:hover {
    background: var(--color-bg);
    border-color: var(--color-text-muted);
    text-decoration: none;
  }

  .download-btn.recommended {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .download-btn.recommended:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .download-btn.recommended .btn-note {
    color: rgba(255, 255, 255, 0.8);
  }

  .os-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .btn-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    line-height: 1.2;
  }

  .btn-label {
    white-space: nowrap;
  }

  .btn-note {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .learn-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 0.9375rem;
    background: var(--color-accent);
    color: white;
    transition: all 0.15s ease;
    width: 100%;
  }

  .learn-more:hover {
    background: var(--color-accent-hover);
    color: white;
    text-decoration: none;
  }

  .learn-more svg {
    transition: transform 0.15s ease;
  }

  .learn-more:hover svg {
    transform: translateX(3px);
  }

  /* Compact mode for docs pages */
  .download-buttons.compact {
    gap: 0.75rem;
  }

  .download-buttons.compact .os-buttons {
    gap: 0.5rem;
  }

  .download-buttons.compact .download-btn {
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
  }

  .download-buttons.compact .os-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* Stack buttons on narrow containers */
  @container (max-width: 400px) {
    .os-buttons {
      grid-template-columns: 1fr;
    }
  }

  /* Responsive: stack on small screens */
  @media (max-width: 480px) {
    .os-buttons {
      grid-template-columns: 1fr;
    }
  }

  /* Center content on mobile in ProductSection context */
  @media (max-width: 900px) {
    .download-buttons {
      align-items: center;
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>
