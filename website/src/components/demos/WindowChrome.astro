---
interface Props {
  title?: string
  variant?: 'terminal' | 'editor'
}

const { title, variant = 'terminal' } = Astro.props
---

<div class:list={['window-chrome', `window-${variant}`]}>
  <div class="window-titlebar">
    <div class="window-buttons">
      <span class="btn btn-close"></span>
      <span class="btn btn-minimize"></span>
      <span class="btn btn-maximize"></span>
    </div>
    {title && <span class="window-title">{title}</span>}
  </div>
  <div class="window-content">
    <slot />
  </div>
</div>

<style>
  .window-chrome {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .window-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    flex-shrink: 0;
  }

  .window-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .btn-close {
    background: #ff5f57;
  }

  .btn-minimize {
    background: #febc2e;
  }

  .btn-maximize {
    background: #28c840;
  }

  .window-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .window-content {
    flex: 1;
    overflow: hidden;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /*
   * Terminal variant
   * Content stays dark in both modes; chrome adapts via light-dark()
   * Exposes color variables for child demo components to inherit
   */
  .window-terminal {
    /* Terminal palette - available to child components */
    --terminal-text: #cecdc3;
    --terminal-muted: #878580;
    --terminal-blue: #4385be;
    --terminal-green: #879a39;
    --terminal-yellow: #d0a215;

    background: light-dark(#f2f0e5, #1c1b1a);

    .window-titlebar {
      background: light-dark(#e6e4d9, #100f0f);
      border-bottom: 1px solid light-dark(#d9d7cc, #403e3c);
    }

    .window-title {
      color: light-dark(#6f6e69, #878580);
    }

    /* Content always dark, slightly softer in light mode */
    .window-content {
      background: light-dark(#343331, #100f0f);
      color: var(--terminal-text);
    }
  }

  /*
   * Editor variant - fully adapts to theme via light-dark()
   */
  .window-editor {
    background: light-dark(#f2f0e5, var(--color-bg-2));

    .window-titlebar {
      background: light-dark(#e6e4d9, var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }

    .window-title {
      color: var(--color-text-muted);
    }

    .window-content {
      background: light-dark(#fffcf0, var(--color-bg));
    }
  }

  /* Responsive scaling for mobile */
  @media (max-width: 600px) {
    .window-content {
      font-size: 0.625rem;
      padding: 0.75rem;
      line-height: 1.4;
    }

    .window-titlebar {
      padding: 0.5rem 0.625rem;
    }

    .btn {
      width: 10px;
      height: 10px;
    }

    .window-title {
      font-size: 0.625rem;
    }
  }
</style>
